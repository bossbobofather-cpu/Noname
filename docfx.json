{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "Noname/Assembly-CSharp.csproj"
          ]
        }
      ],
      "dest": "api-noname",
      "disableGitFeatures": true,
      "allowCompilationErrors": true
    },
    {
      "src": [
        {
          "files": [
            "Noname/Noname.GameAbilitySystem.Plugin.csproj",
            "Noname/Noname.GameAbilitySystem.Plugin.Editor.csproj"
          ]
        }
      ],
      "dest": "api-plugin",
      "disableGitFeatures": true,
      "allowCompilationErrors": true
    },
    {
      "src": [
        {
          "files": [
            "Noname/Noname.GameHost.Plugin.csproj"
          ]
        }
      ],
      "dest": "api-host",
      "disableGitFeatures": true,
      "allowCompilationErrors": true
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "docs/**.md",
          "docs/**/toc.yml"
        ]
      },
      {
        "files": [
          "api-noname/**.yml",
          "api-noname/index.md"
        ]
      },
      {
        "files": [
          "api-plugin/**.yml",
          "api-plugin/index.md"
        ]
      },
      {
        "files": [
          "api-host/**.yml",
          "api-host/index.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "docs/images/**"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appTitle": "Noname Docs",
      "_enableSearch": true
    },
    "template": [
      "default"
    ]
  }
}
